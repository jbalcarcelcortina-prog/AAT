# Copy to .env and fill in. Both variables are required.

# Prisma datasource.
#   Local (SQLite):  file:./dev.db
#   Vercel/Postgres: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="file:./dev.db"

# Secret used by Auth.js to sign session cookies.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
